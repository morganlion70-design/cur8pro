                                <div class=\"flex-shrink-0 w-12 mr-2 sm:mr-3 sm:w-14 xl:mr-4 xl:w-16\">\n                                                                            <svg class=\"flex-shrink-0 w-12 mr-2 sm:mr-3 sm:w-14 xl:mr-4 xl:w-16\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 78 78\">\r\n                                <rect width=\"77.15\" height=\"77.15\" fill=\"#192A36\" rx=\"24\"\/>\r\n                                <path fill=\"#82FF6F\" fill-rule=\"evenodd\" d=\"M56.363 48.978c.09-.216.136-.447.137-.68V39.5c0-.475-.19-.93-.528-1.267a1.804 1.804 0 0 0-2.545 0A1.788 1.788 0 0 0 52.9 39.5v4.472L41.98 33.11a1.8 1.8 0 0 0-2.546 0l-6.09 6.061-9.772-9.734a1.8 1.8 0 0 0-1.961-.388 1.8 1.8 0 0 0-.974.97 1.785 1.785 0 0 0 .39 1.952l11.045 11a1.805 1.805 0 0 0 2.545 0l6.09-6.06 9.648 9.596h-4.493a1.808 1.808 0 0 0-1.273.524 1.793 1.793 0 0 0-.527 1.267 1.785 1.785 0 0 0 1.11 1.656c.22.09.453.136.69.136H54.7a1.826 1.826 0 0 0 1.272-.525c.17-.169.3-.37.39-.586Z\" clip-rule=\"evenodd\"\/>\r\n                            <\/svg>                                                                    <\/div>\n                            \n                            <h3 class=\"text-lg leading-snug sm:text-xl lg:text-[1.375rem] xl:text-2xl 2xl:text-[1.675rem] font-heading text-theme-slate font-medium\">Low <br>risk<\/h3>\n                        <\/div>\n\n                        <p class=\"mt-auto text-base leading-relaxed lg:text-lg lg:leading-[1.4] xl:text-xl xl:leading-[1.5] 2xl:text-2xl 2xl:leading-[1.4] text-theme-slate\">\n                            Our current IF-ISA investment is a institutional savings account which provides a <span class=\"inline-block px-3 py-0.5 relative z-[1]\"><span class=\"-z-[1] left-0 rounded-full absolute h-full w-full bg-[#82FF6F]\"><\/span>lower risk<\/span> and <span class=\"inline-block px-3 py-0.5 relative z-[1]\"><span class=\"-z-[1] left-0 rounded-full absolute h-full w-full bg-[#82FF6F]\"><\/span>stable<\/span> way to make returns.                        <\/p>\n                    <\/div>\n                <\/div>\n\n                \n                <div class=\"card-item flex flex-col max-w-[370px] xl:max-w-none w-4\/5 xs:w-2\/3 sm:w-[47%] lg:w-2\/5 xl:w-1\/3 px-2 lg:px-3 xl:px-4 xl:pb-8\">\n                    <div class=\"flex flex-col justify-between w-full h-full p-6 bg-white rounded-2xl xl:rounded-3xl lg:p-8\" data-mh=\"match-product-benefits\">\n                        <div class=\"flex items-center mb-8 lg:mb-12\">\n                                                            <div class=\"flex-shrink-0 w-12 mr-2 sm:mr-3 sm:w-14 xl:mr-4 xl:w-16\">\n                                                                            <svg class=\"flex-shrink-0 w-12 mr-2 sm:mr-3 sm:w-14 xl:mr-4 xl:w-16\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 78 78\">\r\n                                <rect width=\"77.15\" height=\"77.15\" fill=\"#192A36\" rx=\"24\"\/>\r\n                                <path fill=\"#82FF6F\" fill-rule=\"evenodd\" d=\"M38.5 54.73c-11.065 0-16.06-12.243-11.279-19.688C31.674 28.672 38.5 24.271 38.5 24.271s6.827 4.4 11.279 10.771c4.78 7.445-.213 19.687-11.28 19.687Zm-4.932-11.683a1.431 1.431 0 0 0-.77-.751 1.441 1.441 0 0 0-1.855.736 1.423 1.423 0 0 0-.04 1.073c.962 2.4 3.124 4.446 6.222 4.8a1.44 1.44 0 0 0 1.055-.302 1.426 1.426 0 0 0-.73-2.537c-1.904-.215-3.254-1.45-3.882-3.019Z\" clip-rule=\"evenodd\"\/>\r\n                            <\/svg>                                                                    <\/div>\n                            \n                            <h3 class=\"text-lg leading-snug sm:text-xl lg:text-[1.375rem] xl:text-2xl 2xl:text-[1.675rem] font-heading text-theme-slate font-medium\">Liquidity<\/h3>\n                        <\/div>\n\n                        <p class=\"mt-auto text-base leading-relaxed lg:text-lg lg:leading-[1.4] xl:text-xl xl:leading-[1.5] 2xl:text-2xl 2xl:leading-[1.4] text-theme-slate\">\n                            Access <span class=\"inline-block px-3 py-0.5 relative z-[1]\"><span class=\"-z-[1] left-0 rounded-full absolute h-full w-full bg-[#82FF6F]\"><\/span>sharia compliant<\/span> fixed returns without the lock-up period that you would usually need to commit to, in order to get those kind of returns with an Islamic bank.                        <\/p>\n                    <\/div>\n                <\/div>\n\n                \n            <\/div>\n        <\/div>\n    <\/div>\n<\/section>\n\n\n<section id=\"vl-faqs-block_8080acccb11c6dd6d50aaed7e100b805\" class=\"bg-white  block-vl-faqs pt-16 sm:pt-20 pb-16 sm:pb-20 lg:pb-24 2xl:pb-32\">\n    <div class=\"container\">\n        <div class=\"flex flex-wrap\">\n            <div class=\"w-full lg:w-[30%] xl:w-1\/3\">\n                <div class=\"flex flex-col xs:flex-row xs:items-center xs:justify-between lg:flex-col lg:items-start\">\n                    <div class=\"acf-innerblocks-container\">\n\n<h1 class=\"wp-block-heading faq-title\">FAQs<\/h1>\n\n<\/div>\n\n                                            <a href=\"https:\/\/cur8.capital\/faqs\" class=\"mb-4 primary-btn no-margin small link-color blue\">All FAQs<\/a>\n                                    <\/div>\n            <\/div>\n\n            <div class=\"w-full lg:w-[70%] xl:w-2\/3 mt-6 lg:mt-0\">\n                <ul x-data=\"Accordion\">\n\n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 1 ? selected = 1 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 1 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">Am I eligible for an IF-ISA<\/span>\n            \n            <svg :class=\"selected == 1 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container1\" x-bind:style=\"selected == 1 ? 'max-height: ' + ($refs.container1.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>You need to be aged 18 or over and a UK resident for tax purposes<\/p>\n\n\n\n<p><\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 2 ? selected = 2 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 2 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">How can I open an ISA with Cur8?<\/span>\n            \n            <svg :class=\"selected == 2 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container2\" x-bind:style=\"selected == 2 ? 'max-height: ' + ($refs.container2.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>To sign up for an ISA with Cur8 Capital all you have to do is complete one simple form on our platform and your ISA will be ready to us in less than 24 hours. If you need any assistance you can reach out to us at team@cur8.capital <\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 3 ? selected = 3 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 3 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">How much can I invest in an IF-ISA?<\/span>\n            \n            <svg :class=\"selected == 3 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container3\" x-bind:style=\"selected == 3 ? 'max-height: ' + ($refs.container3.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>You can invest up to \u00a320,000 every tax year which can be split into your various ISA\u2019s (including your cash ISA, stocks and shares ISA, innovative finance ISA and Lifetime ISA.)<\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 4 ? selected = 4 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 4 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">What tax benefits are available in an IF-ISA<\/span>\n            \n            <svg :class=\"selected == 4 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container4\" x-bind:style=\"selected == 4 ? 'max-height: ' + ($refs.container4.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>Investors do not pay any tax on any of the income they receive from ISA savings and investments. Nor do they pay any tax on capital gains arising on ISA investments. However, losses on ISA investments cannot be allowed for Capital Gains Tax purposes against capital gains outside an ISA.<\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 5 ? selected = 5 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 5 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">Can I transfer my existing ISA to Cur8?<\/span>\n            \n            <svg :class=\"selected == 5 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container5\" x-bind:style=\"selected == 5 ? 'max-height: ' + ($refs.container5.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>Absolutely. All IF-ISA eligible deals on the platform provide a link to our ISA Transfer form. Just submit that and the team will take care of the rest and keep you updated on all progress along the way. For any further questions, you can reach out to our team at team@cur8.capital <\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                        <li class=\"py-4 sm:py-5 xl:py-6 border-b border-[#192A36] border-opacity-20 first:pt-0\">\n    <button type=\"button\" class=\"w-full text-left appearance-none focus:outline-none\" @click=\"selected !== 6 ? selected = 6 : selected = null\">\n        <div class=\"flex items-center justify-between group\">\n            <span :class=\"selected == 6 ? 'text-theme-blue' : 'text-theme-slate'\" class=\"mr-8 text-base font-medium leading-normal tracking-tight transition duration-300 lg:text-lg xl:text-xl group-hover:text-theme-blue\">How do I submit an ISA transfer out instruction to Cur8?<\/span>\n            \n            <svg :class=\"selected == 6 ? 'text-theme-blue rotate-180' : 'text-theme-slate'\"  class=\"relative flex-shrink-0 w-3 h-3 transition duration-300 transform group-hover:text-theme-blue\" xmlns=\"http:\/\/www.w3.org\/2000\/svg\" fill=\"none\" viewBox=\"0 0 20 12\">\n                <path stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"3\" d=\"M1.666 1.667 9.999 10l8.334-8.333\"\/>\n            <\/svg>\n        <\/div>\n    <\/button>\n\n    <div class=\"overflow-hidden transition-all duration-300 max-h-0\" x-ref=\"container6\" x-bind:style=\"selected == 6 ? 'max-height: ' + ($refs.container6.scrollHeight + 24) + 'px' : ''\">\n        <div class=\"pt-3 text-base lg:pt-4 xl:pt-6 xl:text-lg text-theme-slate faq-template\">\n            \n<p>ISA managers should submit any ISA transfer instructions to our team inbox at team@cur8.capital. If this is being submitted by post to our correspondence address &#8211;\u00a0IFG.VC\u00a0Limited, Floor 4, 1 Dane&#8217;s Yard, London, England, E15 2QL.<\/p>\n        <\/div>\n    <\/div>\n<\/li>                        \n                    \n                <\/ul>\n            <\/div>\n        <\/div>\n    <\/div>\n<\/section>","protected":false},"excerpt":{"rendered":"","protected":false},"author":17,"featured_media":0,"parent":0,"menu_order":0,"comment_status":"closed","ping_status":"closed","template":"","meta":{"_acf_changed":false,"footnotes":""},"acf":[],"_links":{"self":[{"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/pages\/1010"}],"collection":[{"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/users\/17"}],"replies":[{"embeddable":true,"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/comments?post=1010"}],"version-history":[{"count":5,"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/pages\/1010\/revisions"}],"predecessor-version":[{"id":2386,"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/pages\/1010\/revisions\/2386"}],"wp:attachment":[{"href":"https:\/\/cur8.capital\/wp-json\/wp\/v2\/media?parent=1010"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}